<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ViaCars.eu - Detalii Vehicul</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Plus Jakarta Sans', sans-serif; }
        
        body {
            background: linear-gradient(135deg, rgba(10, 15, 30, 0.88) 0%, rgba(30, 58, 138, 0.28) 50%, rgba(10, 15, 30, 0.88) 100%),
                        url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: #ffffff;
            min-height: 100vh;
        }
        
        .header-integrated {
            background: linear-gradient(180deg, rgba(30, 58, 138, 0.9) 0%, rgba(15, 42, 110, 0.85) 50%, rgba(10, 15, 30, 0.8) 100%);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(59, 130, 246, 0.2);
        }
        
        .logo-container {
            background: linear-gradient(135deg, #1e3a8a, #0f2a6e);
            border: 1px solid rgba(96, 165, 250, 0.3);
            box-shadow: 0 0 20px rgba(30, 58, 138, 0.5), inset 0 0 20px rgba(96, 165, 250, 0.1);
        }
        
        .details-container {
            max-width: 800px;
            margin: 40px auto;
            background: rgba(10, 15, 30, 0.5);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(96, 165, 250, 0.2);
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 0 50px rgba(30, 58, 138, 0.2);
        }
        
        .section-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(96, 165, 250, 0.2);
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-title i { color: #60a5fa; }
        
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }
        @media (max-width: 640px) { .form-grid { grid-template-columns: 1fr; } }
        
        .form-group { display: flex; flex-direction: column; }
        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,0.8);
            margin-bottom: 8px;
        }
        .form-input, .form-select {
            background: rgba(10, 15, 30, 0.6);
            border: 1px solid rgba(96, 165, 250, 0.3);
            color: white;
            padding: 12px 15px;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            transition: all 0.3s ease;
        }
        .form-input:focus, .form-select:focus {
            border-color: #60a5fa;
            box-shadow: 0 0 15px rgba(96, 165, 250, 0.2);
        }
        .form-select option { background: #0a0f1e; color: white; }
        .form-input:disabled, .form-select:disabled {
            background: rgba(30, 58, 138, 0.2);
            color: rgba(255,255,255,0.5);
            cursor: not-allowed;
        }
        
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 12px;
            margin-bottom: 30px;
        }
        .feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(10, 15, 30, 0.4);
            padding: 10px 15px;
            border-radius: 8px;
            border: 1px solid rgba(96, 165, 250, 0.1);
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .feature-item:hover { border-color: rgba(96, 165, 250, 0.4); background: rgba(30, 58, 138, 0.2); }
        .feature-item input[type="checkbox"] {
            accent-color: #60a5fa;
            width: 16px;
            height: 16px;
            cursor: pointer;
        }
        .feature-item label {
            font-size: 13px;
            color: rgba(255,255,255,0.8);
            cursor: pointer;
            margin: 0;
        }
        
        .upload-zone {
            border: 2px dashed rgba(96, 165, 250, 0.3);
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            background: rgba(10, 15, 30, 0.3);
            transition: all 0.3s ease;
            cursor: pointer;
            margin-bottom: 30px;
        }
        .upload-zone:hover {
            border-color: #60a5fa;
            background: rgba(30, 58, 138, 0.15);
        }
        .upload-zone i { font-size: 40px; color: #60a5fa; margin-bottom: 15px; }
        .upload-zone p { color: rgba(255,255,255,0.6); font-size: 14px; margin: 0; }
        .upload-zone span { color: #60a5fa; font-weight: 600; }
        
        .btn-submit {
            width: 100%;
            background: linear-gradient(135deg, #059669, #047857);
            color: white;
            font-weight: 700;
            font-size: 16px;
            padding: 16px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(5, 150, 105, 0.3);
        }
        .btn-submit:hover {
            background: linear-gradient(135deg, #10b981, #059669);
            box-shadow: 0 6px 30px rgba(5, 150, 105, 0.5);
            transform: translateY(-2px);
        }
        
        .flag-btn {
            width: 32px; height: 22px; border-radius: 3px; cursor: pointer;
            transition: all 0.3s ease; border: 2px solid transparent;
            opacity: 0.6; overflow: hidden; display: inline-block;
        }
        .flag-btn:hover { opacity: 1; transform: scale(1.1); }
        .flag-btn.active {
            opacity: 1; border-color: #60a5fa;
            box-shadow: 0 0 10px rgba(96, 165, 250, 0.6); transform: scale(1.1);
        }
        .flag-btn svg { width: 100%; height: 100%; display: block; }
        
        #password-gate {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #0a0f1e; z-index: 99999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
        }
        .pass-box {
            text-align: center; background: rgba(30, 58, 138, 0.1); padding: 40px;
            border-radius: 12px; border: 1px solid rgba(96, 165, 250, 0.3);
            box-shadow: 0 0 40px rgba(30, 58, 138, 0.4); backdrop-filter: blur(10px);
        }
        .pass-input {
            background: rgba(10, 15, 30, 0.7); border: 1px solid rgba(96, 165, 250, 0.3);
            color: white; padding: 10px 15px; border-radius: 6px; width: 200px;
            margin-bottom: 15px; text-align: center; font-size: 14px; outline: none;
        }
        .pass-input:focus { border-color: #60a5fa; box-shadow: 0 0 10px rgba(96, 165, 250, 0.3); }
        .pass-btn {
            background: linear-gradient(135deg, #1e3a8a, #0f2a6e); color: white;
            border: 1px solid rgba(96, 165, 250, 0.4); padding: 10px 30px;
            border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 13px;
            transition: all 0.3s ease;
        }
        .pass-btn:hover { background: linear-gradient(135deg, #2563eb, #1e3a8a); box-shadow: 0 5px 15px rgba(30, 58, 138, 0.5); }
    </style>
</head>
<body>

    <div id="password-gate">
        <div class="pass-box">
            <h2 style="color: white; margin-bottom: 10px; font-size: 24px;">ViaCars.eu</h2>
            <p style="color: rgba(255,255,255,0.6); margin-bottom: 20px; font-size: 14px;">Acces restricționat. Introdu parola.</p>
            <input type="password" id="pass-input" class="pass-input" placeholder="Parola">
            <br>
            <button onclick="checkPassword()" class="pass-btn">Intră</button>
            <p id="pass-error" style="color: #ef4444; font-size: 12px; margin-top: 10px; display: none;">Parolă incorectă!</p>
        </div>
    </div>

